# EasyShip AI — environment keys
# Unset keys degrade gracefully to estimate/mock behavior (no crash).

# ---- AI chat / agent ----
# Required for AI assistant replies. Unset → chat falls back / errors politely.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Stripe (booking commission) ----
# Unset STRIPE_SECRET_KEY → /api/create-commission-payment returns 503.
# Unset VITE_STRIPE_PUBLIC_KEY → client shows payments-unavailable empty state (no Elements crash).
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ---- Live carrier rates ----
# Unset → /api/live-rates and quotes use estimate/mock rates (source: estimate, not live).
# MAERSK_API_KEY=your_maersk_key
# MSC_API_KEY=your_msc_key

# ---- Freight forwarders ----
# Unset → forwarder options use mock/estimate pricing.
# FREIGHT_FORWARDER_API_KEY=your_key
# ---- Express / forwarder APIs (optional) ----
# Unset -> mock/estimate forwarder quotes (not live DHL/FedEx/UPS).
# DHL_API_KEY=your_dhl_key
# FEDEX_API_KEY=your_fedex_key
# UPS_API_KEY=your_ups_key

# ---- Optional enrichment ----
# EXCHANGE_RATE_API_KEY=your_api_key_here   # Unset → cached/fallback FX
# GOOGLE_MAPS_API_KEY=your_api_key_here    # Unset → address autocomplete limited

# Environment
NODE_ENV=development
